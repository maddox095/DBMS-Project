# Local Docker Compose settings. Copy this file to .env before starting the stack.
APP_PORT=3000
MYSQL_ROOT_PASSWORD=local-mysql-root
MYSQL_DATABASE=byproduct_exchange
MYSQL_USER=exchange
MYSQL_PASSWORD=local-mysql-password
MYSQL_PORT=3306
MYSQL_AUTH_PASSWORD=local-exchange-auth-password
MYSQL_PRODUCER_PASSWORD=local-exchange-producer-password
MYSQL_CONSUMER_PASSWORD=local-exchange-consumer-password
MYSQL_WORKER_PASSWORD=local-exchange-worker-password

POSTGRES_DB=byproduct_search
POSTGRES_USER=exchange_search
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=5432
